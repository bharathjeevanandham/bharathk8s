apiVersion: batch/v1
kind: CronJob
metadata:
  name: neo4j-backup
  namespace: neo4j

spec:
  schedule: "45 17 * * *"
  successfulJobsHistoryLimit: 5
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      template:
        spec:
          securityContext:
            runAsUser: 7474
            runAsGroup: 7474
          initContainers:
          - name: cleanup-old-backup
            image: neo4j/neo4j-admin:2026.04.0
            command:
            - /bin/bash
            - -c
            - | 
              set -euo pipefail
              echo "cleaning up backups started at $(date)"
              find /backups -mindepth 1 -maxdepth 1 -type d -mtime +10 -exec rm -rvf {} +
              echo "clean up completed at $(date)"
            volumeMounts:
              - name: backup-storage
                mountPath: /backups

          containers:
          - name: neo4j-backup
            image: neo4j/neo4j-admin:2026.04.0
            command:
            - /bin/bash
            - -c
            - |
              BACKUP_DIR="/backups/$(date +%Y-%m-%d)"
              mkdir -p $BACKUP_DIR
              neo4j-admin database dump neo4j --to-path=$BACKUP_DIR
              echo "Backup completed: $BACKUP_DIR"
            volumeMounts:
            - name: backup-storage
              mountPath: /backups
          restartPolicy: OnFailure
          
          volumes:
          - name: backup-storage
            hostPath:
              path: /data/neo4j/backups
              type: DirectoryOrCreate
            persistentVolumeClaim:
              claimName: backup-neo4j

